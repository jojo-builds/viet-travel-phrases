# SpeakLocal repo-level local/runtime ignore rules
#
# Keep repo truth visible. Ignore only local temp/runtime surfaces that should
# not drive queue selection, repo audits, or workflow decisions.

# Local Codex/Desktop runtime state
/memory/
/state/

# Queue runtime temp and mutable local ledgers
/.agent/__pycache__/
/.agent/coordination/.queue-locks/
/.agent/coordination/queue-events.jsonl
/.agent/coordination/desktop-app-recovery.json
/.agent/tasks/*/state.json.*.tmp
/.agent/archive/tasks/*/state.json.*.tmp
/.agent/archive/tasks/*/logs/*.exe

# Disposable build/export inspection roots
/tmp-eas-inspect-*/
/tmp-eas-prebuild-*/

# Local Expo preview/export artifacts
/app/.expo/
/app/.expo-web-*/
/app/.expo-export*/
/app/artifacts/
/app/tmp-expo-web.log

# Local native iOS review captures
/native-ios/artifacts/
/native-ios/**/*.xcuserstate
/native-ios/**/*.xcuserdata/

# Local orchestrator generated artifacts
/orchestrator/artifacts/

# Local city render-proof scratch captures. The durable proof screenshots live
# in tracked screenshots-single-* folders; these rerun folders can be recreated.
/docs/editorial-exports/viet-city-pages/food-listings-production-2026-05-30/render-proof-2026-06-01-v2-2-global/*-screenshots/
/docs/editorial-exports/viet-city-pages/food-listings-production-2026-05-30/render-proof-2026-06-01-v2-2-global/*-test-screenshots/
/docs/editorial-exports/viet-city-pages/food-listings-production-2026-05-30/render-proof-2026-06-01-v2-2-global/*-derived-data/
/docs/editorial-exports/viet-city-pages/food-listings-production-2026-05-30/render-proof-2026-06-01-v2-2-global/xcodebuild-logs/*/

# Local parallel feature worktrees
/.worktrees/

# Python/local scratch
__pycache__/
*.py[cod]
/.DS_Store
.DS_Store
/.venv/
.venv/
/tmp/
/.tmp_*
