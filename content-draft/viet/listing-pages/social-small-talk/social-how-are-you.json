  "sections": [
    {
      "id": "at-glance",
      "title": "At a glance",
      "body": "Bạn khỏe không? is friendly, but it is not the only way to check in. With older people or service staff, Vietnamese often sounds warmer when you swap bạn for anh, chị, cô, chú, ông, or bà.",
      "presentation": "plain-text"
    },
    {
      "id": "breakdown",
      "title": "Break it down",
      "body": "This pattern turns the phrase into a yes-or-no question. Keep the main need together so the question stays natural.",
      "breakdown": [
        {
          "id": "smalltalk-7-piece-1",
          "vietnamese": "Bạn",
          "english": "you",
          "audioKey": "breakdown-smalltalk-7-first"
        },
        {
