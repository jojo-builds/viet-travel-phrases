    {
      "id": "why-it-matters",
      "title": "Why it matters",
      "body": "These phrases keep the interaction cooperative when repeating the same words is not helping.",
      "presentation": "plain-text"
    },
    {
      "id": "when-to-use",
      "title": "When to use it",
      "body": "Use it for hotel addresses, pickup points, prices, room numbers, names, or any detail you need to keep after the conversation ends.",
      "presentation": "plain-text"
    },
    {
      "id": "watch-out",
      "title": "Watch out",
      "body": "Do not make it sound like a demand. A calm tone keeps the request cooperative, especially if the person already repeated themselves once.",
      "presentation": "warning-callout"
    },
    {
      "id": "local-tip",
      "title": "Local tip",
      "body": "Hand over your phone with a blank note open if paper is not nearby. The phrase plus the blank screen usually makes the request obvious.",
      "presentation": "tip-callout"
    },
