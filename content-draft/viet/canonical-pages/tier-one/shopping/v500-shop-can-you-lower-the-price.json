  "title": "Giảm giá chút được không?",
  "englishTitle": "Can you lower the price?",
  "pronunciation": "zam zah choot dook khong",
  "summary": "Use this when bargaining is normal and you want to ask for a small discount.",
  "iconName": "bag.fill",
  "tintName": "purple",
  "categoryIDs": [
    "shopping"
  ],
  "audioKey": "audio-authored-giam-gia-chut-duoc-khong-a718a9e74f",
  "sections": [
    {
      "id": "at-glance",
      "title": "At a glance",
      "body": "Use this in markets or flexible-price shops, not at fixed-price counters. Giảm giá chút được không? asks for a small discount without using the peer-like bạn, so it keeps the bargain about the price instead of the relationship.",
      "presentation": "plain-text",
      "phrases": [],
      "breakdown": []
    },
    {
      "id": "breakdown",
      "title": "Break it down",
      "body": "This pattern asks for a yes-or-no answer. Keep the main need together so the question feels natural.",
      "breakdown": [
        {
          "id": "v500-shop-can-you-lower-the-price-piece-1",
          "vietnamese": "Giảm giá",
          "english": "lower the price",
          "audioKey": "breakdown-authored-giam-gia-dc1ca2512b"
        },
        {
          "id": "v500-shop-can-you-lower-the-price-piece-2",
          "vietnamese": "chút",
          "english": "a little",
          "audioKey": "breakdown-v500-unde-repa-i-understand-a-little-piece-4"
        },
        {
          "id": "v500-shop-can-you-lower-the-price-piece-3",
          "vietnamese": "được không?",
          "english": "is it possible?",
          "audioKey": "breakdown-authored-duoc-khong-cc7ef288f9"
        },
        {
          "id": "v500-shop-can-you-lower-the-price-full",
          "vietnamese": "Giảm giá chút được không?",
          "english": "Can you lower the price?",
