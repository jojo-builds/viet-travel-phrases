        }
      ],
      "presentation": "phrase-list"
    },
    {
      "id": "why-it-matters",
      "title": "Why it matters",
      "body": "This phrase names the bag problem before you start explaining. That helps airport staff move straight to the baggage tag, flight details, or next counter. It is more useful than a broad lost-bag sentence when the bag may simply be delayed, still on another carousel, or waiting for a staff handoff.",
      "presentation": "plain-text"
    },
    {
      "id": "traveler-insight",
      "title": "Traveler insight",
      "body": "Staff may answer with a baggage-tag request, a counter direction, a form, or an update on where to wait. Keep your tag visible while you listen, and be ready to show the flight number if they ask. The next useful phrase is usually a document handoff, not another explanation.",
      "phrases": [
        {
          "id": "airport-1",
          "vietnamese": "Nhập cảnh ở đâu?",
          "english": "Where is immigration?",
          "pronunciation": "nyup canh uh dow",
          "symbolName": "speaker.wave.2.fill",
          "tintName": "blue",
          "detailPageID": "viet-family-airport-immigration",
          "audioKey": "airport-1"
        },
        {
          "id": "airport-2",
          "vietnamese": "Lấy hành lý ở đâu?",
          "english": "Where is baggage claim?",
          "pronunciation": "lay han lee uh dow",
          "symbolName": "speaker.wave.2.fill",
          "tintName": "blue",
          "detailPageID": "viet-family-airport-baggage",
          "audioKey": "airport-2"
        },
        {
          "id": "airport-3",
          "vietnamese": "Mua SIM ở đâu?",
          "english": "Where can I buy a SIM card?",
