  "sections": [
    {
      "id": "at-glance",
      "title": "At a glance",
      "body": "Use this at baggage claim when your bag has not appeared. Show your baggage tag immediately after saying it so staff can match the phrase to the real item. The useful move is naming the missing bag first, before you try to explain the flight, carousel, or timing.",
      "presentation": "plain-text"
    },
    {
      "id": "breakdown",
      "title": "Break it down",
      "body": "Hành lý means baggage. Của tôi means my. Chưa means not yet. Tới means arrived or reached.",
      "breakdown": [
        {
          "id": "airport-6-piece-1",
          "vietnamese": "Hành lý",
          "english": "baggage",
          "audioKey": "breakdown-airport-baggage-subject-2"
        },
