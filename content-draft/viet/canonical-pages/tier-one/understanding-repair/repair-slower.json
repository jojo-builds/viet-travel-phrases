    {
      "id": "good-to-know",
      "title": "Good to know",
      "body": "Tone matters here. Curious and calm sounds like a request; sharp or repeated too many times can sound like a challenge.",
      "presentation": "tip-callout",
      "phrases": [],
      "breakdown": []
    },
    {
      "id": "local-tip",
      "title": "Local tip",
      "body": "If the slower repeat still misses, point, write, or show the exact word. The goal is clarity, not winning the spoken exchange.",
