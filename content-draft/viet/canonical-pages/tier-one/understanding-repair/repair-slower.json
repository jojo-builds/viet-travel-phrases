      "presentation": "horizontal-phrase-cards",
      "breakdown": []
    },
    {
      "id": "why-it-matters",
      "title": "Why it matters",
      "body": "A slower repeat is often more useful than another full-speed answer. This phrase gives the other person a clear repair path: slow down, point, write, or show the detail.",
      "presentation": "plain-text",
      "phrases": [],
      "breakdown": []
    },
    {
      "id": "traveler-insight",
      "title": "Traveler insight",
      "body": "The reply may come as slower Vietnamese, one important word, a pointed explanation, or writing.",
      "phrases": [
        {
