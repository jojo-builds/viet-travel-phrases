    {
      "id": "standard-way",
      "title": "The standard way",
      "body": "Say Nói chậm chút được không? once, then pause. Watch for a slower repeat, a gesture toward the object, or a move to writing on paper or a phone.",
      "phrases": [
        {
          "id": "problems-3",
          "vietnamese": "Nói chậm chút được không?",
          "english": "Can you speak a little slower?",
