      "breakdown": []
    },
    {
      "id": "natural-variations",
      "title": "Natural variations",
      "body": "These versions change the pressure of the request. Pick the softer one for service counters and the shorter one when the person already understands what you need.",
      "phrases": [
        {
          "id": "repair-slower-polite",
          "vietnamese": "Nói chậm giúp tôi được không?",
          "english": "Could you speak a little slower, please?",
          "pronunciation": "noy chuhm zoop toy dook khong",
          "symbolName": "speaker.wave.2.fill",
          "tintName": "blue",
          "detailPageID": "viet-phrase-repair-slower-polite",
          "audioKey": "repair-slower-polite"
        }
