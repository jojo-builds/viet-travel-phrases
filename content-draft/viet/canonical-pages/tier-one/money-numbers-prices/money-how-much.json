    {
      "id": "good-to-know",
      "title": "Good to know",
      "body": "Confirm the final price before handing over cash or card, especially when several items, bags, or add-ons are involved.",
      "presentation": "tip-callout"
    },
    {
      "id": "local-tip",
      "title": "Local tip",
      "body": "If the answer comes too fast, hand over your phone calculator or point to theirs. Numbers are easier to trust when both people can see them.",
