    {
      "id": "standard-way",
      "title": "The standard way",
      "body": "Use Cái này bao nhiêu? before the transaction starts. Keep the item visible, then listen for a spoken number or watch for a typed price.",
      "phrases": [
        {
          "id": "price-1",
          "vietnamese": "Cái này bao nhiêu?",
          "english": "How much is this?",
          "pronunciation": "gai nai bao nyew",
          "symbolName": "speaker.wave.2.fill",
          "tintName": "green",
          "detailPageID": null,
          "audioKey": "price-1"
        }
      ],
      "presentation": "phrase-list"
    },
    {
      "id": "natural-variations",
      "title": "Natural variations",
      "body": "Use these when the price question needs a softer tone, a total, or a clearer object. The pointing still does most of the work.",
      "phrases": [
        {
          "id": "money-how-much-common",
          "vietnamese": "Cái này nhiêu tiền?",
