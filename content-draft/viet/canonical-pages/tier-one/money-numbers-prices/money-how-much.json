  "sections": [
    {
      "id": "at-glance",
      "title": "At a glance",
      "body": "Cái này bao nhiêu? is the market-counter question for one visible thing: a bag, snack, shirt, ride item, or menu photo. Point first so the answer can be short, typed, or shown on a calculator.",
      "presentation": "plain-text"
    },
    {
      "id": "breakdown",
      "title": "Break it down",
      "body": "Listen to each piece, then the whole phrase, so the rhythm feels connected instead of memorized word by word.",
      "breakdown": [
        {
          "id": "price-1-piece-1",
          "vietnamese": "Cái",
          "english": "item / classifier",
          "audioKey": "breakdown-repair-3-first"
        },
        {
          "id": "price-1-piece-2",
          "vietnamese": "này",
          "english": "this",
          "audioKey": "breakdown-v900-food-drin-is-this-cooked-piece-2"
        },
        {
