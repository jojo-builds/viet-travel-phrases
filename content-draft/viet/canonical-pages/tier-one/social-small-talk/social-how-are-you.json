  "audioKey": "smalltalk-7",
  "sections": [
    {
      "id": "at-glance",
      "title": "At a glance",
      "body": "Bạn khỏe không? is friendly, but it is not the only way to check in. With older people or service staff, Vietnamese often sounds warmer when you swap bạn for anh, chị, cô, chú, ông, or bà.",
      "presentation": "plain-text",
      "phrases": [],
      "breakdown": []
    },
    {
      "id": "breakdown",
      "title": "Break it down",
      "body": "This pattern asks for a yes-or-no answer. Keep the main need together so the question feels natural.",
      "breakdown": [
        {
          "id": "smalltalk-7-piece-1",
          "vietnamese": "Bạn",
          "english": "you",
          "audioKey": "breakdown-smalltalk-7-first"
        },
        {
          "id": "smalltalk-7-piece-2",
          "vietnamese": "khỏe",
          "english": "healthy / well",
          "audioKey": "breakdown-authored-khoe-172d93f8d9"
        },
        {
          "id": "smalltalk-7-piece-3",
          "vietnamese": "không?",
          "english": "not? / yes-no ending",
          "audioKey": "breakdown-bath-6-piece-6"
        },
        {
          "id": "smalltalk-7-full",
          "vietnamese": "Bạn khỏe không?",
          "english": "How are you?",
          "audioKey": "smalltalk-7"
        }
      ],
      "presentation": "breakdown-strip",
      "phrases": []
    },
    {
      "id": "standard-way",
      "title": "The standard way",
      "body": "Bạn khỏe không? works best with peers, friends, classmates, or someone whose age relationship feels close to yours.",
      "phrases": [
        {
          "id": "smalltalk-7",
          "vietnamese": "Bạn khỏe không?",
          "english": "How are you?",
          "pronunciation": "ban khoe khong",
          "symbolName": "speaker.wave.2.fill",
          "tintName": "green",
          "detailPageID": null,
          "audioKey": "smalltalk-7"
        }
      ],
      "presentation": "phrase-list",
      "breakdown": []
    },
    {
      "id": "why-it-matters",
      "title": "Why it matters",
      "body": "Small talk in Vietnamese often becomes warmer when it connects to place, food, or shared experience. Keep the relevant place, item, or screen visible.",
      "presentation": "plain-text",
      "phrases": [],
      "breakdown": []
    },
    {
      "id": "traveler-insight",
      "title": "Traveler insight",
      "body": "The reply may be a smile, a time, or light follow-up question. Say Bạn khỏe không?",
      "phrases": [
        {
          "id": "smalltalk-1",
          "vietnamese": "Tôi đến từ Mỹ",
          "english": "I’m from the United States",
          "pronunciation": "toy den too mee",
          "symbolName": "speaker.wave.2.fill",
          "tintName": "green",
          "detailPageID": "viet-family-social-from-us",
          "audioKey": "smalltalk-1"
        },
        {
          "id": "smalltalk-2",
          "vietnamese": "Tôi từ Anh",
          "english": "I’m from England",
          "pronunciation": "toy too anh",
          "symbolName": "speaker.wave.2.fill",
          "tintName": "green",
          "detailPageID": "viet-family-social-from-uk",
          "audioKey": "smalltalk-2"
        },
        {
          "id": "smalltalk-3",
          "vietnamese": "Đây là lần đầu của tôi",
          "english": "This is my first time",
          "pronunciation": "day la lun dow koo-ah toy",
          "symbolName": "speaker.wave.2.fill",
          "tintName": "green",
          "detailPageID": "viet-family-social-first-time",
          "audioKey": "smalltalk-3"
        }
      ],
      "presentation": "phrase-list",
      "breakdown": []
    },
    {
      "id": "relationship-forms",
      "title": "Relationship forms",
      "body": "Swap bạn when the relationship is clear. These versions sound warmer with older or younger people because Vietnamese treats the relationship word as part of the sentence.",
      "phrases": [
        {
          "id": "how-are-you-anh",
          "vietnamese": "Anh khỏe không?",
          "english": "How are you, older man?",
          "pronunciation": "anh khweh khom",
          "symbolName": "speaker.wave.2.fill",
          "tintName": "blue",
          "detailPageID": null,
          "audioKey": "audio-authored-anh-khoe-khong-942769853d"
        },
        {
          "id": "how-are-you-chi",
          "vietnamese": "Chị khỏe không?",
          "english": "How are you, older woman?",
          "pronunciation": "chee khweh khom",
          "symbolName": "speaker.wave.2.fill",
          "tintName": "red",
