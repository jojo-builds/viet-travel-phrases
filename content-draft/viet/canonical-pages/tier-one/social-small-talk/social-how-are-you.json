  "depth": "deep",
  "title": "Bạn khỏe không?",
  "englishTitle": "How are you?",
  "pronunciation": "ban khoe khong",
  "summary": "Use this after a greeting with someone close enough for light conversation.",
  "iconName": "bubble.left.and.bubble.right.fill",
  "tintName": "green",
  "categoryIDs": [
    "small-talk",
    "greetings"
