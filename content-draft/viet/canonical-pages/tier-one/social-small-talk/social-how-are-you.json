        {
          "id": "how-are-you-em",
          "vietnamese": "Em khỏe không?",
          "english": "How are you, younger person?",
          "pronunciation": "em khweh khom",
          "symbolName": "speaker.wave.2.fill",
          "tintName": "green",
          "detailPageID": null,
          "audioKey": "audio-phrase-em-khoe-khong"
        }
      ],
      "presentation": "phrase-list",
      "breakdown": []
    },
    {
      "id": "when-to-use",
      "title": "When to use it",
      "body": "Use it after Xin chào or Chào bạn, not as the very first sentence to a stranger in a rushed service moment.",
      "phrases": [
        {
          "id": "smalltalk-4",
          "vietnamese": "Tôi thích Việt Nam",
          "english": "I like Vietnam",
          "pronunciation": "toy thik vyet nam",
