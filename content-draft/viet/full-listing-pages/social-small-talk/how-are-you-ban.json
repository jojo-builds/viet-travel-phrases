  "sections": [
    {
      "id": "at-glance",
      "title": "At a glance",
      "body": "Bạn khỏe không? is the friendly peer version of how are you. It works after a greeting when the person feels close to your age, casual, or friendly enough for bạn. With older or younger people, Vietnamese often sounds warmer when you swap bạn for anh, chị, or em."
    },
    {
      "id": "standard-way",
      "title": "The standard way",
      "body": "Use Bạn khỏe không? with peers, friendly guides, classmates, younger adults near your age, or someone who has already made the exchange casual.",
      "phrases": [
        {"id": "smalltalk-7", "vietnamese": "Bạn khỏe không?", "english": "How are you?", "pronunciation": "ban khoe khong", "symbolName": "speaker.wave.2.fill", "tintName": "green", "detailPageID": null, "audioKey": "smalltalk-7"}
      ]
    },
    {
      "id": "breakdown",
      "title": "Break it down",
      "body": "The pattern stays the same while the first word changes by relationship.",
