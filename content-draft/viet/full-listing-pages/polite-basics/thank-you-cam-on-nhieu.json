    {"id": "at-glance", "title": "At a glance", "body": "Cảm ơn nhiều is the easy way to make thank you feel stronger without becoming formal or dramatic. Use it when someone carries a bag, gives patient directions, waits for you, fixes a small problem, or does more than the minimum."},
    {"id": "standard-way", "title": "The standard way", "body": "Say Cảm ơn nhiều when plain Cảm ơn feels a little too small for the help you received.", "phrases": [{"id": "polite-thank-you-polite", "vietnamese": "Cảm ơn nhiều", "english": "Thank you very much", "pronunciation": "kahm uhn nyew", "symbolName": "speaker.wave.2.fill", "tintName": "green", "detailPageID": null, "audioKey": "polite-thank-you-polite"}]},
    {"id": "breakdown", "title": "Break it down", "body": "The last word turns the thank-you up a notch.", "breakdown": [{"id": "cam-on", "vietnamese": "Cảm ơn", "english": "thank you", "audioKey": "polite-2"}, {"id": "nhieu", "vietnamese": "nhiều", "english": "much / a lot", "audioKey": null}, {"id": "full", "vietnamese": "Cảm ơn nhiều", "english": "thank you very much", "audioKey": "polite-thank-you-polite"}]},
