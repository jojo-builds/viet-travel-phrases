  "sections": [
    {"id": "at-glance", "title": "At a glance", "body": "Cảm ơn bạn đã hiểu is for moments when the other person stayed patient while you explained, repeated, used translation, or corrected a misunderstanding. It thanks them for understanding, not just for a service."},
    {"id": "standard-way", "title": "The standard way", "body": "Say this after the problem is clear and the other person has accepted your explanation.", "phrases": [{"id": "v500-unde-repa-thank-you-for-understanding", "vietnamese": "Cảm ơn bạn đã hiểu", "english": "Thank you for understanding", "pronunciation": "cam on ban da hieu", "symbolName": "speaker.wave.2.fill", "tintName": "blue", "detailPageID": null, "audioKey": "v500-unde-repa-thank-you-for-understanding"}]},
    {"id": "breakdown", "title": "Break it down", "body": "The phrase adds the person and the reason for your thanks.", "breakdown": [{"id": "cam-on", "vietnamese": "Cảm ơn", "english": "thank you", "audioKey": "polite-2"}, {"id": "ban", "vietnamese": "bạn", "english": "you / friend", "audioKey": null}, {"id": "da-hieu", "vietnamese": "đã hiểu", "english": "understood", "audioKey": null}, {"id": "full", "vietnamese": "Cảm ơn bạn đã hiểu", "english": "thank you for understanding", "audioKey": "v500-unde-repa-thank-you-for-understanding"}]},
    {"id": "natural-variations", "title": "Before this thank-you", "body": "These are often the phrases that make this closing line useful.", "phrases": [{"id": "problems-2", "vietnamese": "Tôi không hiểu", "english": "I don't understand", "pronunciation": "toy khom hee-ew", "symbolName": "speaker.wave.2.fill", "tintName": "blue", "detailPageID": "viet-family-repair-understand", "audioKey": "problems-2"}, {"id": "repair-premium-simpler-words", "vietnamese": "Bạn có thể sử dụng những từ đơn giản hơn?", "english": "Can you use simpler words?", "pronunciation": "ban co the su dung nhung tu don gian hon", "symbolName": "speaker.wave.2.fill", "tintName": "blue", "detailPageID": "viet-family-repair-simpler-words", "audioKey": "repair-premium-simpler-words"}, {"id": "repair-1", "vietnamese": "Làm ơn nói lại", "english": "Please say that again", "pronunciation": "lahm uhn noy lie", "symbolName": "speaker.wave.2.fill", "tintName": "blue", "detailPageID": "viet-family-repair-repeat", "audioKey": "repair-1"}]},
    {"id": "when-to-use", "title": "When to use it", "body": "Use it after a language mix-up, a patient explanation, a translated message, or a situation where the other person adjusted to your limited Vietnamese."},
    {"id": "good-to-know", "title": "Good to know", "body": "This phrase is warmer than plain Cảm ơn because it names what you appreciate. It is a good closing line after a difficult interaction becomes cooperative."},
    {"id": "explore-next", "title": "Explore next", "body": "These help you move through and close the same kind of interaction.", "phrases": [{"id": "directions-7", "vietnamese": "Cảm ơn, tôi hiểu rồi", "english": "Thanks, I understand now", "pronunciation": "kahm uhn toy hyew roy", "symbolName": "speaker.wave.2.fill", "tintName": "orange", "detailPageID": "viet-thanks-cam-on-toi-hieu-roi", "audioKey": "directions-7"}, {"id": "polite-thank-you-polite", "vietnamese": "Cảm ơn nhiều", "english": "Thank you very much", "pronunciation": "kahm uhn nyew", "symbolName": "speaker.wave.2.fill", "tintName": "green", "detailPageID": "viet-thanks-cam-on-nhieu", "audioKey": "polite-thank-you-polite"}, {"id": "polite-7", "vietnamese": "Tạm biệt", "english": "Goodbye", "pronunciation": "tahm bee-et", "symbolName": "speaker.wave.2.fill", "tintName": "purple", "detailPageID": "viet-goodbye", "audioKey": "polite-7"}]}
